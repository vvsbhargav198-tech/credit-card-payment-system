                  "key": "token",
                  "value": "{{admin_access_token}}",
                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "Deactivate a user",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{django_url}}/api/admin/users/2/",
