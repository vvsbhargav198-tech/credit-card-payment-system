                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('admin_access_token', pm.response.json().access);"
                ]
              }
            }
          ]
        },
        {
          "name": "Users",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{django_url}}/api/admin/users/",
              "host": [
                "{{django_url}}"
              ],
              "path": [
                "api",
