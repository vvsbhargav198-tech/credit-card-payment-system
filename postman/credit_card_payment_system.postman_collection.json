                "exec": [
                  "pm.test('Status is 201', function () { pm.response.to.have.status(201); });",
                  "pm.collectionVariables.set('card_id', pm.response.json().id);",
                  "pm.test('No full number / CVV returned', function () {",
                  "  var text = pm.response.text();",
                  "  pm.expect(text).to.not.include('4111111111111111');",
                  "  pm.expect(pm.response.json()).to.not.have.property('cvv');",
                  "});"
