
# Django
DJANGO_SECRET_KEY=change-me-django-secret-key-please-use-50-random-characters-xxxxxxxx
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# JWT - MUST be identical for Django (issues tokens) and FastAPI (verifies tokens)
JWT_SECRET_KEY=change-me-shared-jwt-secret-at-least-32-bytes-long-0123456789
JWT_ALGORITHM=HS256
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=1

# MySQL (created by database/01_create_database.sql in MySQL Workbench)
DB_NAME=credit_card_payments
DB_USER=django_tests
DB_PASSWORD=Password12345!
DB_HOST=127.0.0.1
DB_PORT=3306

# Payment simulator (FastAPI)
PAYMENT_SUCCESS_RATE=0.8
PAYMENT_PROCESSING_DELAY=0
